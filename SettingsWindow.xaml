<Window x:Class="VolumeCtrlWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ToggleButton x:Name="NavGeneral" Content="常规" Width="88" Height="32" Margin="0,0,6,0" Click="OnNavClick" Style="{StaticResource NavButton}"/>
            <ToggleButton x:Name="NavApps" Content="应用音量" Width="88" Height="32" Margin="0,0,6,0" Click="OnNavClick" Style="{StaticResource NavButton}"/>
            <ToggleButton x:Name="NavHotkeys" Content="快捷键" Width="88" Height="32" Margin="0,0,6,0" Click="OnNavClick" Style="{StaticResource NavButton}"/>
            <ToggleButton x:Name="NavAbout" Content="关于" Width="88" Height="32" Click="OnNavClick" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="PageGeneral"/>
                <StackPanel x:Name="PageApps" Visibility="Collapsed"/>
                <StackPanel x:Name="PageHotkeys" Visibility="Collapsed"/>
                <StackPanel x:Name="PageAbout" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="82" Height="30" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="取消" Width="82" Height="30" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
