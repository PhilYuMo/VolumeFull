<Window x:Class="VolumeCtrlWpf.BalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声道平衡" Height="300" Width="380"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="AppName" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="LeftLabel" Text="左声道" FontSize="12" Margin="0,4,0,2"/>
            <Slider x:Name="LeftSlider" Minimum="0" Maximum="100" Height="24" Margin="0,0,0,12" Style="{StaticResource Win11Slider}"/>
            <TextBlock x:Name="RightLabel" Text="右声道" FontSize="12" Margin="0,4,0,2"/>
            <Slider x:Name="RightSlider" Minimum="0" Maximum="100" Height="24" Margin="0,0,0,12" Style="{StaticResource Win11Slider}"/>
            <TextBlock x:Name="HintText" Text="提示：0 = 静音该声道，100 = 全音量；两声道都 100 为居中。" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="居中" Width="72" Height="30" Margin="0,0,8,0" Click="OnCenter"/>
            <Button Content="确定" Width="72" Height="30" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="取消" Width="72" Height="30" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
